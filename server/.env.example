# Copy to server/.env (never committed) and fill in, or set these in the environment.
# tools/run_server.sh and tools/build_firmware.sh read it; left empty, PET_HERMES_KEY is read
# from the bixo Hermes profile and PET_PUBLIC_HOST is this machine's Tailscale name.

# Random path segment of the OTA URL; the firmware is built with it. openssl rand -hex 24
PET_SECRET=
# Public name the Watcher reaches this server at, e.g. my-mac.my-tailnet.ts.net
PET_PUBLIC_HOST=

# hermes (default) or claude
PET_BRAIN=hermes
# API_SERVER_KEY of the bixo Hermes profile
PET_HERMES_KEY=
# Only with PET_BRAIN=claude
ANTHROPIC_API_KEY=

# Optional, see the table in README.md
# PET_ALLOWED_DEVICES=aa:bb:cc:dd:ee:ff
# PET_VOICE=es-ES-XimenaNeural
# PET_TIMEZONE=Europe/Madrid
# PET_SESSION_GAP_MIN=60
